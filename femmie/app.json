{
  "expo": {
    "name": "Femmie",
    "slug": "femmie",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#F7F7FA"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.femmie.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F7F7FA"
      },
      "package": "com.femmie.app"
    },
    "plugins": [
      "expo-notifications",
      "expo-sqlite",
      "expo-secure-store",
      "react-native-health",
      "react-native-health-connect",
      "expo-asset",
      "react-native-libsodium"
    ]
  }
}
