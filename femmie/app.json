{
  "expo": {
    "name": "Femmie",
    "slug": "femmie",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#F7F7FA"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.femmie.app",
      "config": {
        "usesNonExemptEncryption": false
      },
      "buildNumber": "6",
      "appleTeamId": "RW75468DH6"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F7F7FA"
      },
      "package": "com.femmie.app"
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "15.1"
          }
        }
      ],
      "./plugins/withResourceBundleDeploymentTarget",
      "expo-notifications",
      "expo-secure-store",
      [
        "react-native-health",
        {
          "healthSharePermission": "Femmie reads your sleep, heart rate variability, resting heart rate, weight, workouts and cycle data from Apple Health to show how they relate to your cycle. This data stays encrypted on your device.",
          "healthUpdatePermission": "Femmie saves the period days you log to Apple Health so your cycle history stays in one place."
        }
      ],
      "react-native-health-connect",
      "expo-asset",
      "react-native-libsodium"
    ],
    "extra": {
      "eas": {
        "projectId": "37030386-a8be-4f85-9b78-96779f3e9114"
      }
    },
    "owner": "alexhendrickxs-team"
  }
}
