# Dependencies
node_modules/

# Expo / React Native
.expo/
dist/
web-build/
*.jsbundle

# Native build output (Expo managed — regenerated by prebuild)
/ios/
/android/

# Logs
*.log
npm-debug.*
yarn-debug.*
